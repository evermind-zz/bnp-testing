<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/internal_vol_relative_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:background="@drawable/background_oval_white_transparent"
    android:visibility="gone"
    tools:visibility="visible">

    <ProgressBar
        android:id="@+id/internal_vol_progress_bar"
        style="?android:progressBarStyleHorizontal"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:indeterminate="false"
        android:progressDrawable="@drawable/progress_circular_grey" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/internal_vol_image_view"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_centerInParent="true"
        app:tint="@color/gray"
        tools:ignore="ContentDescription"
        tools:src="@drawable/ic_volume_up" />
</RelativeLayout>

